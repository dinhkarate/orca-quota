{
  "manifestVersion": 2,
  "id": "agent-usage",
  "name": "Agent Usage",
  "version": "0.2.0",
  "description": "Tokens and cost for every coding agent on the machine (Claude Code, Codex, pi, omp, Grok, OpenCode, dsh, Antigravity), by day, agent, model and project, read from their own logs; plus plan limits and credits for each account.",
  "author": {
    "name": "dinhkarate",
    "url": "https://github.com/dinhkarate"
  },
  "license": "MIT",
  "repository": "https://github.com/dinhkarate/orca-quota",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "agent-usage",
        "title": "Agent Usage",
        "icon": "bar-chart-3",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "usage.refresh",
        "title": "Agent Usage: Read new usage and quota now"
      },
      {
        "id": "usage.toggle",
        "title": "Agent Usage: Toggle the right sidebar",
        "action": "sidebar.right.toggle"
      }
    ],
    "statusBarItems": [
      {
        "id": "usage",
        "text": "Usage",
        "icon": "bar-chart-3",
        "tooltip": "Agent Usage: reading logs…",
        "command": "usage.toggle"
      }
    ],
    "settings": [
      {
        "key": "refreshMinutes",
        "title": "Read quota every (minutes)",
        "description": "How often plan limits are read again. Claude's usage endpoint rate-limits frequent reads. Token usage is read every minute.",
        "type": "integer",
        "default": 5,
        "minimum": 2,
        "maximum": 60
      },
      {
        "key": "fetchPrices",
        "title": "Download model prices",
        "description": "Fetch LiteLLM's public price table from GitHub once a day to price tokens the agents did not price themselves. Nothing about your usage is sent.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "statusBarIgnore",
        "title": "Quota providers the status bar skips",
        "description": "Comma-separated, e.g. \"Copilot, Qoder\". The status bar adds a provider's quota only when it runs low; the panel still shows every one.",
        "type": "string",
        "default": "",
        "placeholder": "Copilot, Qoder"
      },
      {
        "key": "nineRouterUrl",
        "title": "9router URL",
        "description": "Leave empty to use the 9router pi or omp send requests to. Its CLI token goes in the panel's Keys section.",
        "type": "string",
        "default": "",
        "placeholder": "https://9router.example.com"
      },
      {
        "key": "readAgentConfigs",
        "title": "Read keys and logins from pi and omp",
        "description": "auth.json and models.json under ~/.pi/agent and ~/.omp/agent.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "claude",
        "title": "Claude",
        "description": "Claude Code's login (macOS Keychain or ~/.claude/.credentials.json).",
        "type": "boolean",
        "default": true
      },
      {
        "key": "codex",
        "title": "Codex",
        "description": "~/.codex/auth.json (or $CODEX_HOME).",
        "type": "boolean",
        "default": true
      },
      {
        "key": "grok",
        "title": "Grok",
        "description": "~/.grok/auth.json.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "copilot",
        "title": "GitHub Copilot",
        "description": "The token `gh auth token` prints.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "openrouter",
        "title": "OpenRouter",
        "type": "boolean",
        "default": true
      },
      {
        "key": "deepseek",
        "title": "DeepSeek",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "secrets:own"
    }
  ]
}
